generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum CheckStatus {
  // Legacy values. Kept so rows written before the DNCR rule update stay
  // readable; nothing writes them any more.
  ALLOWED
  BLOCKED
  ERROR

  // Current values, matching DncrFinalStatus in shared/dncrStatus.ts.
  DNCR_REGISTERED
  DNCR_NOT_REGISTERED
  UNKNOWN
  CHECK_FAILED
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(EMPLOYEE)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  checkLogs CheckLog[]

  @@map("users")
}

model CheckLog {
  id            String      @id @default(uuid())
  phoneNumber   String
  /// The interpreted outcome. See shared/dncrStatus.ts.
  status        CheckStatus
  /// Raw dncrStatus exactly as the API sent it - null included. Never rewritten.
  dncrStatus    String?
  /// Raw transactionStatus exactly as the API sent it. Never rewritten.
  rawTransactionStatus String?
  /// ALLOWED | NOT_ALLOWED, derived from status.
  callPermission String?
  /// Which rule produced the interpretation, so a result stays explainable.
  appliedRule   String?
  /// Human-readable reason, mainly for UNKNOWN and CHECK_FAILED rows.
  reason        String?     @db.Text
  transactionId String?
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  apiLogs       ApiLog[]

  @@map("check_logs")
}

model ApiLog {
  id              String   @id @default(uuid())
  checkLogId      String
  checkLog        CheckLog @relation(fields: [checkLogId], references: [id])
  requestUrl      String   @db.Text
  requestMethod   String
  requestHeaders  Json
  requestBody     Json?
  responseStatus  Int
  responseBody    Json?
  createdAt       DateTime @default(now())

  @@map("api_logs")
}
